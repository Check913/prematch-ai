# Copiez ce fichier en `.env` et remplissez vos valeurs.
# Le fichier .env n'est JAMAIS partage ni versionne.

# Bot Telegram : creez-le via @BotFather, puis copiez le token ici.
TELEGRAM_BOT_TOKEN=

# Votre chat id : envoyez /start a votre bot puis consultez
# https://api.telegram.org/bot<TOKEN>/getUpdates -> result[0].message.chat.id
TELEGRAM_CHAT_ID=

# Optionnel : cle gratuite https://the-odds-api.com (500 req/mois)
ODDS_API_KEY=
